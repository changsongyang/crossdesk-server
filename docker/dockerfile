FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libsqlite3-0 \
        libstdc++6 \
        openssl && \
    rm -rf /var/lib/apt/lists/*

# Coturn runs in a separate, pinned official container.
# This image contains only CrossDesk Server and its certificate helper.
COPY --chmod=755 docker/start.sh /start.sh
COPY --chmod=755 docker/generate_certs.sh /docker/generate_certs.sh
COPY --chmod=755 dist/crossdesk_server /crossdesk-server/crossdesk_server
COPY src/admin/web /crossdesk-server/admin

ENTRYPOINT ["/start.sh"]
